# Copy this file to .env next to chainspec.config.json, then fill only the chosen provider.
# Google Cloud Translation Basic v2
GOOGLE_TRANSLATE_API_KEY=

# Baidu General Translation
BAIDU_TRANSLATE_APP_ID=
BAIDU_TRANSLATE_SECRET_KEY=

# Youdao Text Translation v3 authentication
YOUDAO_TRANSLATE_APP_KEY=
YOUDAO_TRANSLATE_SECRET_KEY=
